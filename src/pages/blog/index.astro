---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.id.includes('/'))   // hide nested subpages
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---
<BaseLayout title="Writing · Conor O'Shea">
  <section class="article">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-tag">/ writing</span>
        <h2>Project write-ups</h2>
      </div>
      <div class="projects">
        {posts.map((post) => (
          <a class="project" href={`/blog/${post.id}`}>
            {post.data.icon && (
              <div class="project-icon"><img src={post.data.icon} alt="" loading="lazy" /></div>
            )}
            <div class="project-body">
              <h3>{post.data.title}</h3>
              {post.data.description && <p class="tagline">{post.data.description}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>
