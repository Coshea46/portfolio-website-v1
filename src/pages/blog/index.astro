---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.id.includes('/'))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---
<BaseLayout title="Writing · Conor O'Shea">
  <section class="article">
    <div class="wrap">
      <div class="sec-head">
        <span class="sec-tag">/ writing</span>
        <h2>Project write-ups</h2>
      </div>
      <div class="projects">
        {posts.map((post) => (
          <article class="project">
            <div class="project-banner contain">
              {post.data.icon && <img src={post.data.icon} alt="" loading="lazy" />}
            </div>
            <div class="project-body">
              <h3>{post.data.title}</h3>
              {post.data.description && <p class="tagline">{post.data.description}</p>}
              <div class="project-links">
                <a class="plink primary" href={`/blog/${post.id}`}>Read write-up</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>
