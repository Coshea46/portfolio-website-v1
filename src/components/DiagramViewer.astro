<dialog class="diagram-viewer" id="diagram-viewer" aria-labelledby="diagram-viewer-title">
  <div class="diagram-toolbar">
    <h2 id="diagram-viewer-title">Diagram</h2>
    <div class="diagram-controls">
      <button type="button" data-diagram-zoom="out" aria-label="Zoom out">−</button>
      <button type="button" data-diagram-zoom="fit">Fit</button>
      <button type="button" data-diagram-zoom="in" aria-label="Zoom in">+</button>
      <output class="diagram-zoom-level" aria-live="polite">100%</output>
      <button type="button" data-diagram-close autofocus>Close</button>
    </div>
  </div>
  <div class="diagram-viewport" tabindex="0" role="region" aria-label="Expanded image; scroll to explore when zoomed in">
    <div class="diagram-canvas"></div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#diagram-viewer')!;
  const viewport = dialog.querySelector<HTMLDivElement>('.diagram-viewport')!;
  const canvas = dialog.querySelector<HTMLDivElement>('.diagram-canvas')!;
  const title = dialog.querySelector<HTMLHeadingElement>('#diagram-viewer-title')!;
  const zoomLevel = dialog.querySelector<HTMLOutputElement>('output')!;
  const zoomOut = dialog.querySelector<HTMLButtonElement>('[data-diagram-zoom="out"]')!;
  const zoomIn = dialog.querySelector<HTMLButtonElement>('[data-diagram-zoom="in"]')!;
  let active: HTMLImageElement | SVGSVGElement | null = null;
  let returnFocus: HTMLElement | null = null;
  let placeholder: Comment | null = null;
  let originalStyle: string | null = null;
  let width = 1;
  let height = 1;
  let zoom = 1;

  function resizeDiagram() {
    if (!active) return;
    const centerX = (viewport.scrollLeft + viewport.clientWidth / 2) / Math.max(canvas.clientWidth, 1);
    const centerY = (viewport.scrollTop + viewport.clientHeight / 2) / Math.max(canvas.clientHeight, 1);
    const fit = Math.min((viewport.clientWidth - 48) / width, (viewport.clientHeight - 48) / height);
    const scaledWidth = width * fit * zoom;
    const scaledHeight = height * fit * zoom;
    active.style.width = `${scaledWidth}px`;
    active.style.height = `${scaledHeight}px`;
    active.style.maxWidth = 'none';
    active.style.maxHeight = 'none';
    canvas.style.width = `${Math.max(viewport.clientWidth, scaledWidth + 48)}px`;
    canvas.style.height = `${Math.max(viewport.clientHeight, scaledHeight + 48)}px`;
    viewport.scrollLeft = centerX * canvas.clientWidth - viewport.clientWidth / 2;
    viewport.scrollTop = centerY * canvas.clientHeight - viewport.clientHeight / 2;
    zoomLevel.value = `${Math.round(zoom * 100)}%`;
    zoomOut.disabled = zoom <= 0.5;
    zoomIn.disabled = zoom >= 8;
  }

  function openDiagram(source: HTMLImageElement | SVGSVGElement, trigger: HTMLElement, label: string) {
    if (dialog.open) return;
    returnFocus = trigger;
    title.textContent = label;
    zoom = 1;
    if (source instanceof SVGSVGElement) {
      width = source.viewBox.baseVal.width || source.getBoundingClientRect().width;
      height = source.viewBox.baseVal.height || source.getBoundingClientRect().height;
      // Move the SVG temporarily so its IDs and embedded styles stay unique.
      placeholder = document.createComment('expanded diagram');
      source.before(placeholder);
      originalStyle = source.getAttribute('style');
      active = source;
    } else {
      width = source.naturalWidth || source.width;
      height = source.naturalHeight || source.height;
      active = source.cloneNode(true) as HTMLImageElement;
      active.removeAttribute('id');
      active.removeAttribute('srcset');
      active.src = source.dataset.expandSrc || source.currentSrc || source.src;
      active.loading = 'eager';
      const expandedImage = active;
      expandedImage.addEventListener('load', () => {
        if (active !== expandedImage || !dialog.open) return;
        width = expandedImage.naturalWidth;
        height = expandedImage.naturalHeight;
        resizeDiagram();
      }, { once: true });
    }
    canvas.replaceChildren(active);
    document.documentElement.classList.add('diagram-open');
    dialog.showModal();
    resizeDiagram();
    viewport.scrollTo(0, 0);
  }

  function changeZoom(next: number) {
    zoom = Math.min(8, Math.max(0.5, next));
    resizeDiagram();
  }

  zoomOut.addEventListener('click', () => changeZoom(zoom / 1.5));
  zoomIn.addEventListener('click', () => changeZoom(zoom * 1.5));
  dialog.querySelector('[data-diagram-zoom="fit"]')!.addEventListener('click', () => changeZoom(1));
  dialog.querySelector('[data-diagram-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener('keydown', (event) => {
    if (event.key === '+' || event.key === '=') changeZoom(zoom * 1.5);
    else if (event.key === '-') changeZoom(zoom / 1.5);
    else if (event.key === '0') changeZoom(1);
    else return;
    event.preventDefault();
  });
  dialog.addEventListener('close', () => {
    if (placeholder && active) {
      if (originalStyle === null) active.removeAttribute('style');
      else active.setAttribute('style', originalStyle);
      placeholder.replaceWith(active);
    }
    canvas.replaceChildren();
    active = null;
    placeholder = null;
    document.documentElement.classList.remove('diagram-open');
    returnFocus?.focus({ preventScroll: true });
  });
  window.addEventListener('resize', () => { if (dialog.open) resizeDiagram(); });

  function installDiagramTriggers() {
    document.querySelectorAll<HTMLImageElement>('.prose img, .experience-media img').forEach((image) => {
      if (image.closest('a, button')) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'diagram-image-button';
      const experiencePhoto = image.closest('.experience-media');
      const label = experiencePhoto?.querySelector('figcaption')?.textContent?.trim() || image.alt || 'Diagram';
      button.setAttribute('aria-label', `Expand ${label}`);
      button.setAttribute('aria-haspopup', 'dialog');
      button.setAttribute('aria-controls', dialog.id);
      const hint = document.createElement('span');
      hint.className = experiencePhoto ? 'photo-expand-label' : 'diagram-expand-hint';
      hint.textContent = experiencePhoto ? 'Expand photo' : 'Click to expand';
      hint.setAttribute('aria-hidden', 'true');
      image.before(button);
      button.append(image, hint);
      button.addEventListener('click', () => openDiagram(image, button, label));
    });
    document.querySelectorAll<HTMLElement>('.prose .mermaid').forEach((diagram) => {
      const svg = diagram.querySelector('svg');
      if (!svg || diagram.classList.contains('diagram-expandable')) return;
      diagram.classList.add('diagram-expandable');
      diagram.tabIndex = 0;
      diagram.setAttribute('role', 'button');
      diagram.setAttribute('aria-label', 'Expand system architecture diagram');
      diagram.setAttribute('aria-haspopup', 'dialog');
      diagram.setAttribute('aria-controls', dialog.id);
      const hint = document.createElement('span');
      hint.className = 'diagram-expand-hint';
      hint.textContent = 'Click to expand';
      hint.setAttribute('aria-hidden', 'true');
      diagram.append(hint);
      const open = () => openDiagram(svg, diagram, 'System architecture');
      diagram.addEventListener('click', open);
      diagram.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open();
        }
      });
    });
  }

  installDiagramTriggers();
  document.addEventListener('diagrams:rendered', installDiagramTriggers);
</script>
