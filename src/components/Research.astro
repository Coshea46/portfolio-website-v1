---
import profile from '../data/profiles.yaml';

const { research } = profile;
---

<section id="research">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-tag">02 / research experience</span>
      <h2>AI &amp; Cybersecurity Research Internship</h2>
      <p>
        Recently completed a research internship at the University of Edinburgh’s
        School of Informatics.
      </p>
    </div>

    <div class="paper-card reveal">
      <span class="paper-label">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
        </svg>

        {research.label}
      </span>

      <h3>{research.title}</h3>

      <p>{research.summary}</p>

      <ul class="paper-contribs">
        {research.contributions.map((contribution: string) => (
          <li>{contribution}</li>
        ))}
      </ul>

      <p class="paper-note">{research.note}</p>

      <div class="paper-meta">
        {research.meta.map((item: { label: string; value: string }) => (
          <span>
            <b>{item.label}:</b>&nbsp;{item.value}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
