---
const groups = [
  { label: 'Languages', items: ['Python', 'Java', 'JavaScript', 'C', 'MIPS assembly'] },
  { label: 'Machine learning', items: ['PyTorch', 'YOLO', 'LSTM / RNNs', 'LLM evaluation', 'NER evaluation'] },
  { label: 'Systems & data', items: ['FastAPI', 'AWS S3', 'Modal', 'FFmpeg', 'Data preprocessing', 'Anonymisation'] },
  { label: 'Tools', items: ['pytest', 'Vercel', 'Kaggle', 'Git'] },
];
---
<section id="skills" class="skills-section">
  <div class="wrap">
    <div class="section-heading"><span class="section-number">03</span><h2>Skills</h2></div>
    <div class="skills-grid">{groups.map(group => <div class="skill-group"><h3>{group.label}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div>
  </div>
</section>
