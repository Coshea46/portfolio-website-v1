---
import profile from '../data/profiles.yaml';
---
<header class="hero" id="top">
  <div class="wrap">
    <span class="badge"><span class="pulse"></span>{profile.availability}</span>
    <h1>Building intelligent systems<br />at the intersection of<br /><span class="grad">AI &amp; security.</span></h1>
    <p class="role">// {profile.role}</p>
    <div class="lead">
        {profile.lead.map((para: string) => <p>{para}</p>)}
    </div>
    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary">View my work
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>
    <div class="hero-stats">
      {profile.stats.map((s: any) => (
        <div class="stat"><div class="num">{s.num}</div><div class="lbl">{s.label}</div></div>
      ))}
    </div>
  </div>
</header>
