---
import projectsData from '../data/projects_details.yaml';
const { projects } = projectsData;

const linkIcons: Record<string, string> = {
  github: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2 0 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.3 1.2-3.2 0-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 5 18 5.3 18 5.3c.6 1.7.1 2.9.1 3.2.8.9 1.2 2 1.2 3.2 0 4.7-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>',
  blog: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
  commits: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><line x1="1.05" y1="12" x2="7" y2="12"/><line x1="17" y1="12" x2="22.95" y2="12"/></svg>',
  webapp: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>',
};
const iconFor = (type: string) => linkIcons[type] ?? linkIcons.webapp;
const isExternal = (url: string) => url.startsWith('http');
---
<section id="projects">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-tag">03 / projects</span>
      <h2>Selected work</h2>
      <p>End-to-end builds, from model research to deployed applications and teaching resources.</p>
    </div>

    <div class="projects">
      {projects.map((p: any) => {
        const primary = p.links.find((l: any) => l.primary) ?? p.links[0];
        const rest = p.links.filter((l: any) => l !== primary);
        return (
          <article class="project reveal">
            <div class="project-banner cover">
              <img src={p.banner ?? p.icon} alt={`${p.name} preview`} loading="lazy" />

              <span class="project-badge">Featured work</span>
              {p.live && <span class="project-live"><span class="dot-live"></span>Live</span>}
            </div>

            <div class="project-body">
              <h3>{p.name}</h3>

              <div class="project-tech">
                {p.tech.map((t: string) => <span class="chip">{t}</span>)}
              </div>

              <p class="tagline">{p.tagline}</p>

              {p.concepts && (
                <div class="concepts">
                  <div class="g-lbl">concepts taught</div>
                  <div class="chips">
                    {p.concepts.map((c: string) => <span class="chip">{c}</span>)}
                  </div>
                </div>
              )}

              <div class="project-links">
                {primary && (
                  <a
                    class="plink primary"
                    href={primary.url}
                    target={isExternal(primary.url) ? '_blank' : undefined}
                    rel={isExternal(primary.url) ? 'noopener' : undefined}
                  >
                    <Fragment set:html={iconFor(primary.type)} />
                    {primary.label}
                  </a>
                )}
                {rest.length > 0 && (
                  <div class="project-links-row">
                    {rest.map((l: any) => (
                      <a
                        class="plink"
                        href={l.url}
                        target={isExternal(l.url) ? '_blank' : undefined}
                        rel={isExternal(l.url) ? 'noopener' : undefined}
                      >
                        <Fragment set:html={iconFor(l.type)} />
                        {l.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
