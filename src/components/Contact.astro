---
import profile from '../data/profiles.yaml';
---
<section id="contact" class="contact-section">
  <div class="wrap contact-grid">
    <div><p class="eyebrow">04 / Contact</p><h2>Let’s talk.</h2><p>Seeking summer 2027 internships in ML, applied AI and software engineering. Based in Edinburgh and eligible to work in the UK.</p></div>
    <div class="contact-links"><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a><div class="card-actions"><a class="small-btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a><a class="small-btn" href={profile.github} target="_blank" rel="noopener">GitHub</a><a class="small-btn" href={profile.resume} target="_blank" rel="noopener">Read my CV</a></div></div>
  </div>
</section>
